{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "tailwind": {
    "stylesheet": "./src/styles/index.css"
  },
  "markdown": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useImportType": {
          "level": "error",
          "options": {
            "style": "inlineType"
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../../*", "../../**"],
                "message": "Go up one folder at most (`../`); further than that, use the `@/` alias."
              }
            ]
          }
        }
      },
      "nursery": {
        "useConsistentFunctionStyle": {
          "level": "error",
          "options": {
            "style": "declaration",
            "allowArrowFunctions": false
          }
        },
        "useTailwindSortedClasses": "error"
      }
    }
  }
}
