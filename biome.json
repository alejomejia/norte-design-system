{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "assist": {
    "actions": { "source": { "organizeImports": "on" } }
  },
  "linter": {
    "rules": {
      "style": {
        "useImportType": { "level": "error", "options": { "style": "inlineType" } },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [{ "group": ["../*"], "message": "Use the `@/` alias instead of `../`." }]
          }
        }
      },
      "nursery": {
        "useConsistentFunctionStyle": {
          "level": "error",
          "options": { "style": "declaration", "allowArrowFunctions": false }
        },
        "useTailwindSortedClasses": "error"
      }
    }
  }
}
